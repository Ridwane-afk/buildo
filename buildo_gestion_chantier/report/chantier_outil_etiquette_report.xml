<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_etiquette_outil" model="ir.actions.report">
        <field name="name">Étiquettes QR des outils</field>
        <field name="model">chantier.outil</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">buildo_gestion_chantier.etiquette_outil</field>
        <field name="report_file">buildo_gestion_chantier.etiquette_outil</field>
        <field name="print_report_name">'Etiquettes QR outils'</field>
        <field name="binding_model_id" ref="model_chantier_outil"/>
        <field name="binding_type">report</field>
        <field name="group_ids" eval="[Command.link(ref('group_chef_chantier'))]"/>
    </record>

    <template id="etiquette_outil">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="page">
                    <div class="row">
                        <t t-foreach="docs" t-as="o">
                            <div class="col-4 text-center mb-4" style="page-break-inside: avoid;">
                                <div style="border: 1px dashed #9ca3af; padding: 8px;">
                                    <img t-att-src="image_data_uri(o.qr_code)" style="width: 45mm; height: 45mm;"/>
                                    <div class="fw-bold" t-out="o.name"/>
                                    <div class="small" t-if="o.ref_interne" t-out="o.ref_interne"/>
                                    <div class="small text-muted">BUILDO · Scannez pour prendre ou rendre</div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
