<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Canal Discuss réservé à la direction (et donc à l'administrateur BUILDO) :
         ses membres sont abonnés automatiquement par leur groupe. -->
    <record id="canal_resume_buildo" model="discuss.channel">
        <field name="name">Résumé BUILDO</field>
        <field name="description">Résumé quotidien de l'activité terrain : heures, photos et demandes de matériel.</field>
        <field name="group_public_id" ref="group_direction"/>
        <field name="group_ids" eval="[Command.link(ref('group_direction'))]"/>
    </record>

    <record id="cron_resume_quotidien" model="ir.cron">
        <field name="name">BUILDO : résumé quotidien de l'activité terrain</field>
        <field name="model_id" ref="model_chantier_chantier"/>
        <field name="state">code</field>
        <field name="code">model._cron_resume_quotidien()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- 18:00 UTC, soit 19:00 à Bruxelles en hiver -->
        <field name="nextcall" eval="(DateTime.now() + relativedelta(hour=18, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

    <!-- Types d'activité des rappels automatiques : un par sujet, pour éviter les doublons
         et fermer la bonne activité quand le problème est réglé. -->
    <record id="activite_outil_a_rendre" model="mail.activity.type">
        <field name="name">Outil à rendre</field>
        <field name="icon">fa-wrench</field>
        <field name="res_model">chantier.attribution.outil</field>
        <field name="decoration_type">warning</field>
    </record>

    <record id="activite_heures_a_encoder" model="mail.activity.type">
        <field name="name">Heures à encoder</field>
        <field name="icon">fa-clock-o</field>
        <field name="res_model">chantier.chantier</field>
    </record>

    <record id="activite_budget_depasse" model="mail.activity.type">
        <field name="name">Budget dépassé</field>
        <field name="icon">fa-exclamation-triangle</field>
        <field name="res_model">chantier.chantier</field>
        <field name="decoration_type">warning</field>
    </record>

    <record id="cron_alertes_quotidiennes" model="ir.cron">
        <field name="name">BUILDO : rappels outils en retard, heures oubliées et budgets dépassés</field>
        <field name="model_id" ref="model_chantier_chantier"/>
        <field name="state">code</field>
        <field name="code">model._cron_alertes_quotidiennes()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- 06:00 UTC, soit 07:00 à Bruxelles en hiver : avant le départ sur chantier -->
        <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1, hour=6, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

    <record id="action_envoyer_resume" model="ir.actions.server">
        <field name="name">Envoyer le résumé maintenant</field>
        <field name="model_id" ref="model_chantier_chantier"/>
        <field name="state">code</field>
        <field name="code">action = model.action_envoyer_resume()</field>
        <field name="group_ids" eval="[Command.link(ref('group_direction'))]"/>
    </record>
</odoo>
