<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chantier_rapport_journalier_form" model="ir.ui.view">
        <field name="name">chantier.rapport.journalier.form</field>
        <field name="model">chantier.rapport.journalier</field>
        <field name="arch" type="xml">
            <form string="Rapport journalier">
                <sheet>
                    <group>
                        <group>
                            <field name="chantier_id"/>
                            <field name="auteur_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="meteo"/>
                            <field name="nb_ouvriers"/>
                        </group>
                    </group>
                    <group string="Travaux réalisés">
                        <field name="travaux_realises" nolabel="1" placeholder="Décrire les travaux effectués..."/>
                    </group>
                    <group string="Incidents / Remarques">
                        <field name="incidents" nolabel="1" placeholder="Incidents, problèmes, remarques..."/>
                    </group>
                    <group string="Notes complémentaires">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_chantier_rapport_journalier_list" model="ir.ui.view">
        <field name="name">chantier.rapport.journalier.list</field>
        <field name="model">chantier.rapport.journalier</field>
        <field name="arch" type="xml">
            <list string="Rapports journaliers">
                <field name="date"/>
                <field name="chantier_id"/>
                <field name="auteur_id"/>
                <field name="meteo"/>
                <field name="nb_ouvriers"/>
            </list>
        </field>
    </record>

    <record id="view_chantier_rapport_journalier_search" model="ir.ui.view">
        <field name="name">chantier.rapport.journalier.search</field>
        <field name="model">chantier.rapport.journalier</field>
        <field name="arch" type="xml">
            <search string="Rechercher un rapport">
                <field name="chantier_id"/>
                <field name="auteur_id"/>
                <separator/>
                <filter string="Aujourd'hui" name="aujourd_hui"
                        domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Cette semaine" name="cette_semaine"
                        domain="[('date', '&gt;=', (context_today() + relativedelta(weekday=0, days=-6)).strftime('%Y-%m-%d')),
                                  ('date', '&lt;=', (context_today() + relativedelta(weekday=6, days=0)).strftime('%Y-%m-%d'))]"/>
                <filter string="Ce mois" name="ce_mois"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01')),
                                  ('date', '&lt;', (context_today() + relativedelta(months=1)).strftime('%Y-%m-01'))]"/>
                <separator/>
                <filter string="Ensoleillé" name="soleil" domain="[('meteo', '=', 'soleil')]"/>
                <filter string="Nuageux" name="nuageux" domain="[('meteo', '=', 'nuageux')]"/>
                <filter string="Pluie" name="pluie" domain="[('meteo', '=', 'pluie')]"/>
                <separator/>
                <filter string="Avec incidents" name="avec_incidents"
                        domain="[('incidents', '!=', False), ('incidents', '!=', '')]"/>
                <group name="groupby">
                    <filter string="Chantier" name="group_chantier" context="{'group_by': 'chantier_id'}"/>
                    <filter string="Auteur" name="group_auteur" context="{'group_by': 'auteur_id'}"/>
                    <filter string="Météo" name="group_meteo" context="{'group_by': 'meteo'}"/>
                    <filter string="Semaine" name="group_semaine" context="{'group_by': 'date:week'}"/>
                    <filter string="Mois" name="group_mois" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_chantier_rapport_journalier" model="ir.actions.act_window">
        <field name="name">Rapports journaliers</field>
        <field name="res_model">chantier.rapport.journalier</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_chantier_rapport_journalier_search"/>
    </record>
</odoo>
