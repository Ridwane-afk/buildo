<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Estimation matériaux -->
    <record id="view_chantier_estimation_materiau_list" model="ir.ui.view">
        <field name="name">chantier.estimation.materiau.list</field>
        <field name="model">chantier.estimation.materiau</field>
        <field name="arch" type="xml">
            <list string="Estimations matériaux" decoration-danger="quantite_manquante &gt; 0">
                <field name="chantier_id"/>
                <field name="materiau_id"/>
                <field name="quantite_estimee"/>
                <field name="unite"/>
                <field name="stock_disponible"/>
                <field name="quantite_manquante"/>
                <field name="montant_estime" sum="Total estimé"/>
                <field name="produit_id" column_invisible="1"/>
                <button name="action_voir_produit" string="Produit" type="object"
                        invisible="not produit_id" class="btn-sm btn-link"/>
                <button name="action_generer_commande" string="Commander" type="object"
                        invisible="quantite_manquante &lt;= 0" class="btn-sm btn-secondary"/>
            </list>
        </field>
    </record>

    <record id="view_chantier_estimation_materiau_search" model="ir.ui.view">
        <field name="name">chantier.estimation.materiau.search</field>
        <field name="model">chantier.estimation.materiau</field>
        <field name="arch" type="xml">
            <search string="Rechercher une estimation">
                <field name="chantier_id"/>
                <field name="materiau_id"/>
                <separator/>
                <filter string="Manquant" name="manquant" domain="[('quantite_manquante', '&gt;', 0)]"/>
                <filter string="Stock suffisant" name="stock_suffisant" domain="[('quantite_manquante', '=', 0)]"/>
                <group name="groupby">
                    <filter string="Chantier" name="group_chantier" context="{'group_by': 'chantier_id'}"/>
                    <filter string="Matériau" name="group_materiau" context="{'group_by': 'materiau_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_chantier_estimation_materiau" model="ir.actions.act_window">
        <field name="name">Estimations matériaux</field>
        <field name="res_model">chantier.estimation.materiau</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_chantier_estimation_materiau_search"/>
    </record>

    <!-- Attribution outils -->
    <record id="view_chantier_attribution_outil_list" model="ir.ui.view">
        <field name="name">chantier.attribution.outil.list</field>
        <field name="model">chantier.attribution.outil</field>
        <field name="arch" type="xml">
            <list string="Attributions outils" decoration-danger="en_retard"
                  decoration-muted="state == 'retourne'">
                <field name="chantier_id"/>
                <field name="outil_id"/>
                <field name="ouvrier_id" widget="many2one_avatar_user"/>
                <field name="date_sortie"/>
                <field name="date_retour_prevue"/>
                <field name="en_retard" column_invisible="1"/>
                <field name="date_retour_reelle"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'attribue'"
                       decoration-success="state == 'retourne'"/>
                <button name="action_rendre" string="Rendre" type="object" icon="fa-undo"
                        invisible="state != 'attribue'" class="btn-sm btn-secondary"/>
            </list>
        </field>
    </record>

    <record id="view_chantier_attribution_outil_form" model="ir.ui.view">
        <field name="name">chantier.attribution.outil.form</field>
        <field name="model">chantier.attribution.outil</field>
        <field name="arch" type="xml">
            <form string="Attribution outil">
                <header>
                    <button name="action_rendre" string="Rendre l'outil" type="object"
                            invisible="state != 'attribue'" class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="chantier_id"/>
                        <field name="outil_id"/>
                        <field name="ouvrier_id"/>
                        <field name="date_sortie"/>
                        <field name="date_retour_prevue"/>
                        <field name="date_retour_reelle" readonly="1"/>
                    </group>
                    <field name="note" placeholder="Note..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_chantier_attribution_outil_search" model="ir.ui.view">
        <field name="name">chantier.attribution.outil.search</field>
        <field name="model">chantier.attribution.outil</field>
        <field name="arch" type="xml">
            <search string="Rechercher une attribution">
                <field name="chantier_id"/>
                <field name="outil_id"/>
                <field name="ouvrier_id"/>
                <separator/>
                <filter string="Attribué" name="attribue" domain="[('state', '=', 'attribue')]"/>
                <filter string="Retourné" name="retourne" domain="[('state', '=', 'retourne')]"/>
                <separator/>
                <filter string="En retard" name="en_retard" domain="[('en_retard', '=', True)]"/>
                <group name="groupby">
                    <filter string="Attribué à" name="group_ouvrier" context="{'group_by': 'ouvrier_id'}"/>
                    <filter string="Catégorie" name="group_categorie" context="{'group_by': 'categorie'}"/>
                    <filter string="Chantier" name="group_chantier" context="{'group_by': 'chantier_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_chantier_attribution_outil" model="ir.actions.act_window">
        <field name="name">Attributions outils</field>
        <field name="res_model">chantier.attribution.outil</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_chantier_attribution_outil_search"/>
        <field name="context">{'search_default_attribue': 1}</field>
    </record>

    <record id="view_chantier_attribution_outil_kanban" model="ir.ui.view">
        <field name="name">chantier.attribution.outil.kanban</field>
        <field name="model">chantier.attribution.outil</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="false">
                <field name="state"/>
                <field name="en_retard"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="outil_id" class="fw-bold fs-5"/>
                            <field name="state" widget="badge" decoration-warning="state == 'attribue'"
                                   decoration-success="state == 'retourne'"/>
                        </div>
                        <div class="small"><i class="fa fa-map-marker me-1" title="Chantier"/><field name="chantier_id"/></div>
                        <div class="small text-muted">Sorti le <field name="date_sortie"/></div>
                        <div t-if="record.state.raw_value == 'attribue'"
                             t-attf-class="small {{ record.en_retard.raw_value ? 'text-danger fw-bold' : '' }}">
                            <t t-if="record.en_retard.raw_value">En retard ! À rendre depuis le </t>
                            <t t-else="">À rendre le </t>
                            <field name="date_retour_prevue"/>
                        </div>
                        <div t-else="" class="small text-muted">Rendu le <field name="date_retour_reelle"/></div>
                        <footer class="mt-2" t-if="record.state.raw_value == 'attribue'">
                            <button name="action_rendre" type="object" class="btn btn-sm btn-primary">
                                <i class="fa fa-undo me-1"/>Rendre
                            </button>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Outils de l'utilisateur connecté (vue ouvrier) : ceux en sa possession d'abord -->
    <record id="action_mes_outils" model="ir.actions.act_window">
        <field name="name">Mes outils</field>
        <field name="res_model">chantier.attribution.outil</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('ouvrier_id', '=', uid)]</field>
        <field name="search_view_id" ref="view_chantier_attribution_outil_search"/>
        <field name="context">{'create': False, 'search_default_attribue': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun outil en votre possession</p>
            <p>Scannez le QR code collé sur un outil pour le prendre,
               ou demandez-le au chef via <strong>Mes demandes</strong>.</p>
        </field>
    </record>
</odoo>
