<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chantier_outil_list" model="ir.ui.view">
        <field name="name">chantier.outil.list</field>
        <field name="model">chantier.outil</field>
        <field name="arch" type="xml">
            <list string="Outils" decoration-warning="etat == 'attribue'"
                  decoration-danger="etat == 'hors_service'">
                <field name="name"/>
                <field name="ref_interne"/>
                <field name="categorie"/>
                <field name="etat" widget="badge"
                       decoration-success="etat == 'disponible'"
                       decoration-warning="etat == 'attribue'"
                       decoration-info="etat == 'maintenance'"
                       decoration-danger="etat == 'hors_service'"/>
                <field name="valeur_achat"/>
                <field name="date_achat"/>
                <field name="attribue_a_id"/>
                <field name="date_retour_prevue"/>
            </list>
        </field>
    </record>

    <record id="view_chantier_outil_form" model="ir.ui.view">
        <field name="name">chantier.outil.form</field>
        <field name="model">chantier.outil</field>
        <field name="arch" type="xml">
            <form string="Outil">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="ref_interne"/>
                            <field name="categorie"/>
                            <field name="etat"/>
                        </group>
                        <group>
                            <field name="valeur_achat"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="date_achat"/>
                            <field name="actif"/>
                        </group>
                    </group>
                    <group string="Attribution en cours" invisible="etat != 'attribue'">
                        <field name="attribue_a_id" readonly="1"/>
                        <field name="date_retour_prevue" readonly="1"/>
                    </group>
                    <field name="description" placeholder="Description..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_chantier_outil_search" model="ir.ui.view">
        <field name="name">chantier.outil.search</field>
        <field name="model">chantier.outil</field>
        <field name="arch" type="xml">
            <search string="Rechercher un outil">
                <field name="name" string="Nom"/>
                <field name="ref_interne"/>
                <field name="categorie"/>
                <field name="attribue_a_id"/>
                <separator/>
                <filter string="Disponible" name="disponible" domain="[('etat', '=', 'disponible')]"/>
                <filter string="Attribué" name="attribue" domain="[('etat', '=', 'attribue')]"/>
                <filter string="En maintenance" name="maintenance" domain="[('etat', '=', 'maintenance')]"/>
                <filter string="Hors service" name="hors_service" domain="[('etat', '=', 'hors_service')]"/>
                <separator/>
                <filter string="Archivés" name="archives" domain="[('actif', '=', False)]"/>
                <group name="groupby">
                    <filter string="Attribué à" name="group_attribue_a" context="{'group_by': 'attribue_a_id'}"/>
                    <filter string="Catégorie" name="group_categorie" context="{'group_by': 'categorie'}"/>
                    <filter string="État" name="group_etat" context="{'group_by': 'etat'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_chantier_outil" model="ir.actions.act_window">
        <field name="name">Outils</field>
        <field name="res_model">chantier.outil</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('actif', '=', True)]</field>
        <field name="search_view_id" ref="view_chantier_outil_search"/>
        <field name="context">{'search_default_group_attribue_a': 1, 'search_default_group_categorie': 1}</field>
    </record>
</odoo>
