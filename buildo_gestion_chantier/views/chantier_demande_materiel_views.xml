<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chantier_demande_materiel_list" model="ir.ui.view">
        <field name="name">chantier.demande.materiel.list</field>
        <field name="model">chantier.demande.materiel</field>
        <field name="arch" type="xml">
            <list string="Demandes de matériel"
                  decoration-success="state == 'valide'" decoration-danger="state == 'refuse'">
                <field name="chantier_id"/>
                <field name="ouvrier_id"/>
                <field name="date"/>
                <field name="type_demande" optional="show"/>
                <field name="description"/>
                <field name="materiau_id" optional="hide"/>
                <field name="outil_id" optional="hide"/>
                <field name="quantite"/>
                <field name="urgence" widget="badge"
                       decoration-danger="urgence == 'urgente'"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'valide'"
                       decoration-danger="state == 'refuse'"
                       decoration-warning="state == 'soumis'"/>
                <button name="action_soumettre" string="Envoyer" type="object" icon="fa-paper-plane"
                        invisible="state != 'brouillon'" class="btn-sm btn-primary"/>
                <button name="action_valider" string="Accepter" type="object" icon="fa-check"
                        invisible="state != 'soumis'" class="btn-sm btn-success"
                        groups="buildo_gestion_chantier.group_chef_chantier"/>
                <button name="action_refuser" string="Refuser" type="object" icon="fa-times"
                        invisible="state != 'soumis'" class="btn-sm btn-secondary"
                        groups="buildo_gestion_chantier.group_chef_chantier"/>
            </list>
        </field>
    </record>

    <record id="view_chantier_demande_materiel_form" model="ir.ui.view">
        <field name="name">chantier.demande.materiel.form</field>
        <field name="model">chantier.demande.materiel</field>
        <field name="arch" type="xml">
            <form string="Demande de matériel">
                <header>
                    <button name="action_soumettre" string="Envoyer au chef" type="object" icon="fa-paper-plane"
                            invisible="state != 'brouillon'" class="btn-primary"/>
                    <button name="action_valider" string="Accepter" type="object"
                            invisible="state != 'soumis'" class="btn-primary"
                            groups="buildo_gestion_chantier.group_chef_chantier"/>
                    <button name="action_refuser" string="Refuser" type="object"
                            invisible="state != 'soumis'"
                            groups="buildo_gestion_chantier.group_chef_chantier"/>
                    <button name="action_reset" string="Remettre en brouillon" type="object"
                            invisible="state not in ('soumis', 'refuse')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="brouillon,soumis,valide"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status" invisible="state != 'valide' or not attribution_id">
                        L'outil vous a été confié. Retrouvez-le dans <strong>Mes outils</strong>.
                    </div>
                    <group>
                        <group>
                            <field name="type_demande" widget="radio" options="{'horizontal': true}"/>
                            <field name="materiau_id" string="Matériau" options="{'no_create': True}"
                                   invisible="type_demande != 'materiau'"/>
                            <field name="outil_id" options="{'no_create': True}"
                                   invisible="type_demande != 'outil'" required="type_demande == 'outil'"/>
                            <field name="outil_etat" widget="badge"
                                   decoration-success="outil_etat == 'disponible'"
                                   decoration-warning="outil_etat == 'attribue'"
                                   decoration-danger="outil_etat in ('maintenance', 'hors_service')"
                                   invisible="not outil_id"/>
                            <field name="description" string="Précisions"
                                   placeholder="Ex. : vis inox 6x60, livrer au 2e étage"
                                   required="not materiau_id and not outil_id"/>
                            <field name="quantite" invisible="type_demande == 'outil'"/>
                            <field name="urgence" widget="radio" options="{'horizontal': true}"/>
                        </group>
                        <group>
                            <field name="chantier_id" options="{'no_create': True}"/>
                            <field name="ouvrier_id" groups="buildo_gestion_chantier.group_chef_chantier"/>
                            <field name="ouvrier_id" readonly="1" groups="!buildo_gestion_chantier.group_chef_chantier"/>
                            <field name="date"/>
                            <field name="attribution_id" invisible="not attribution_id"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Note pour le chef..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_chantier_demande_materiel_search" model="ir.ui.view">
        <field name="name">chantier.demande.materiel.search</field>
        <field name="model">chantier.demande.materiel</field>
        <field name="arch" type="xml">
            <search string="Rechercher une demande">
                <field name="description" string="Description"/>
                <field name="chantier_id"/>
                <field name="ouvrier_id"/>
                <field name="materiau_id"/>
                <separator/>
                <filter string="Brouillon" name="brouillon" domain="[('state', '=', 'brouillon')]"/>
                <filter string="Soumis" name="soumis" domain="[('state', '=', 'soumis')]"/>
                <filter string="Validé" name="valide" domain="[('state', '=', 'valide')]"/>
                <filter string="Refusé" name="refuse" domain="[('state', '=', 'refuse')]"/>
                <separator/>
                <filter string="Urgentes" name="urgentes" domain="[('urgence', '=', 'urgente')]"/>
                <filter string="Outils" name="outils" domain="[('type_demande', '=', 'outil')]"/>
                <filter string="Matériaux" name="materiaux" domain="[('type_demande', '=', 'materiau')]"/>
                <separator/>
                <filter string="Aujourd'hui" name="aujourd_hui"
                        domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Cette semaine" name="cette_semaine"
                        domain="[('date', '&gt;=', (context_today() + relativedelta(weekday=0, days=-6)).strftime('%Y-%m-%d')),
                                  ('date', '&lt;=', (context_today() + relativedelta(weekday=6, days=0)).strftime('%Y-%m-%d'))]"/>
                <filter string="Ce mois" name="ce_mois"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01')),
                                  ('date', '&lt;', (context_today() + relativedelta(months=1)).strftime('%Y-%m-01'))]"/>
                <group name="groupby">
                    <filter string="Chantier" name="group_chantier" context="{'group_by': 'chantier_id'}"/>
                    <filter string="Ouvrier" name="group_ouvrier" context="{'group_by': 'ouvrier_id'}"/>
                    <filter string="État" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Urgence" name="group_urgence" context="{'group_by': 'urgence'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date:week'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_chantier_demande_materiel" model="ir.actions.act_window">
        <field name="name">Demandes de matériel</field>
        <field name="res_model">chantier.demande.materiel</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_chantier_demande_materiel_search"/>
        <field name="context">{'search_default_soumis': 1, 'search_default_group_chantier': 1, 'search_default_group_ouvrier': 1}</field>
    </record>

    <!-- Demandes de l'utilisateur connecté, tous états confondus (vue ouvrier) -->
    <record id="action_mes_demandes_materiel" model="ir.actions.act_window">
        <field name="name">Mes demandes</field>
        <field name="res_model">chantier.demande.materiel</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_chantier_demande_materiel_search"/>
        <field name="domain">[('ouvrier_id', '=', uid)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Besoin de matériel ou d'un outil ?</p>
            <p>Cliquez sur Nouveau, choisissez l'article puis « Envoyer au chef ».
               Vous recevrez un message dès qu'il aura répondu.</p>
        </field>
    </record>
</odoo>
