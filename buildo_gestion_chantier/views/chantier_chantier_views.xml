<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view -->
    <record id="view_chantier_chantier_form" model="ir.ui.view">
        <field name="name">chantier.chantier.form</field>
        <field name="model">chantier.chantier</field>
        <field name="arch" type="xml">
            <form string="Chantier">
                <header>
                    <button name="action_start" string="Démarrer" type="object"
                            invisible="state != 'brouillon'" class="btn-primary"/>
                    <button name="action_terminate" string="Terminer" type="object"
                            invisible="state != 'en_cours'" class="btn-primary"/>
                    <button name="action_cancel" string="Annuler" type="object"
                            invisible="state not in ('brouillon', 'en_cours')"/>
                    <button name="action_reset_draft" string="Remettre en brouillon" type="object"
                            invisible="state not in ('annule', 'termine')"/>
                    <button name="action_ouvrir_rapport_avancement" string="Rapport de suivi" type="object"
                            icon="fa-file-pdf-o" invisible="state == 'brouillon'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="brouillon,en_cours,termine"/>
                </header>
                <sheet>
                    <!-- Smart buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_devis" type="object" class="oe_stat_button"
                                icon="fa-file-text-o">
                            <field name="devis_ids" widget="statinfo" string="Devis"/>
                        </button>
                        <button name="action_view_factures" type="object" class="oe_stat_button"
                                icon="fa-pencil-square-o">
                            <field name="facture_ids" widget="statinfo" string="Factures"/>
                        </button>
                        <button name="action_view_commandes" type="object" class="oe_stat_button"
                                icon="fa-shopping-cart">
                            <field name="commande_fournisseur_ids" widget="statinfo" string="Achats"/>
                        </button>
                        <button name="action_ouvrir_assistant" type="object" class="oe_stat_button"
                                icon="fa-comments">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Assistant IA</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nom du chantier..."/></h1>
                        <div class="d-flex flex-wrap align-items-center text-muted gap-3">
                            <span><i class="fa fa-hashtag me-1" title="Référence"/><field name="ref" readonly="1" class="oe_inline"/></span>
                        </div>
                    </div>
                    <group>
                        <group>
                            <div colspan="2" class="o_horizontal_separator text-uppercase fw-bolder small d-flex align-items-center">
                                <i class="fa fa-info-circle me-1"/>Informations générales
                            </div>
                            <field name="client_id"/>
                            <field name="chef_chantier_id"/>
                            <field name="adresse"/>
                        </group>
                        <group>
                            <div colspan="2" class="o_horizontal_separator text-uppercase fw-bolder small d-flex align-items-center">
                                <i class="fa fa-calendar me-1"/>Planification
                            </div>
                            <field name="date_debut"/>
                            <field name="date_fin_prevue"/>
                            <field name="date_fin_reelle" invisible="state != 'termine'"/>
                            <field name="budget_initial"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <div class="o_horizontal_separator text-uppercase fw-bolder small d-flex align-items-center mt-3"
                         invisible="state == 'brouillon'">
                        <i class="fa fa-bar-chart me-1"/>Indicateurs financiers
                    </div>
                    <div class="row g-3 mb-3" invisible="state == 'brouillon'">
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="border rounded-3 p-3 h-100 bg-light">
                                <div class="text-muted text-uppercase small fw-bold mb-2">
                                    <i class="fa fa-tasks me-1"/>Avancement
                                </div>
                                <field name="avancement" widget="progressbar" nolabel="1" class="mb-0"/>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="border rounded-3 p-3 h-100 bg-light">
                                <div class="text-muted text-uppercase small fw-bold mb-2">
                                    <i class="fa fa-wrench me-1"/>Coût réel
                                </div>
                                <div class="fs-4 fw-bold"><field name="cout_reel" nolabel="1"/></div>
                                <div class="text-muted small">
                                    Main d'œuvre : <field name="cout_main_oeuvre" nolabel="1" class="oe_inline"/>
                                </div>
                                <div class="text-muted small">
                                    Matériaux : <field name="cout_materiaux" nolabel="1" class="oe_inline"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="border rounded-3 p-3 h-100 bg-light">
                                <div class="text-muted text-uppercase small fw-bold mb-2">
                                    <i class="fa fa-file-text-o me-1"/>Facturé
                                </div>
                                <div class="fs-4 fw-bold"><field name="montant_facture" nolabel="1"/></div>
                                <div class="text-muted small">
                                    <field name="nb_heures" nolabel="1" class="oe_inline"/> heures validées
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="border rounded-3 p-3 h-100 bg-light">
                                <div class="text-muted text-uppercase small fw-bold mb-2">
                                    <i class="fa fa-balance-scale me-1"/>Marge
                                </div>
                                <div class="fs-4 fw-bold">
                                    <field name="marge" nolabel="1"
                                           decoration-danger="marge &lt; 0"
                                           decoration-success="marge &gt;= 0"/>
                                </div>
                                <div class="text-muted small" invisible="not budget_revise">
                                    sur budget de <field name="budget_revise" nolabel="1" class="oe_inline"/>
                                </div>
                                <div class="text-muted small" invisible="not montant_avenants_acceptes">
                                    dont <field name="montant_avenants_acceptes" nolabel="1" class="oe_inline"/> d'avenants acceptés
                                </div>
                            </div>
                        </div>
                    </div>
                    <field name="description" placeholder="Description du chantier..."/>
                    <notebook>
                        <page string="Tâches">
                            <field name="tache_ids">
                                <list editable="bottom" delete="false" decoration-success="state == 'fait'" decoration-danger="state == 'bloque'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="responsable_id"/>
                                    <field name="date_debut"/>
                                    <field name="date_fin"/>
                                    <field name="date_fin_reelle"/>
                                    <field name="avancement" widget="progressbar"/>
                                    <field name="montant_facturable"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="facture_id" column_invisible="1"/>
                                    <field name="facture_state" column_invisible="1"/>
                                    <field name="state" widget="badge" readonly="1"
                                           decoration-success="state == 'fait'"
                                           decoration-warning="state == 'en_cours'"
                                           decoration-danger="state == 'bloque'"/>
                                    <button name="action_demarrer" string="Reprendre" type="object"
                                            invisible="state == 'en_cours'" class="btn-sm btn-secondary"/>
                                    <button name="action_valider" string="Valider" type="object"
                                            invisible="state == 'fait'" class="btn-sm btn-primary"/>
                                    <button name="action_bloquer" string="Bloquer" type="object"
                                            invisible="state in ('fait', 'bloque')" class="btn-sm btn-secondary"/>
                                    <button name="action_facturer" string="Facturer au client" type="object"
                                            invisible="state != 'fait' or (facture_id and facture_state != 'cancel')" class="btn-sm btn-primary"
                                            groups="buildo_gestion_chantier.group_direction"/>
                                    <button name="action_open_form" type="object" icon="fa-external-link"
                                            class="btn-sm btn-link" title="Voir le détail"/>
                                    <button name="unlink" type="object" icon="fa-trash-o"
                                            confirm="Êtes-vous sûr de vouloir supprimer cette tâche ?"
                                            class="btn-sm btn-link text-danger"/>
                                </list>
                            </field>
                        </page>
                        <page string="Heures prestées">
                            <field name="heure_prestee_ids">
                                <list>
                                    <field name="ouvrier_id"/>
                                    <field name="date"/>
                                    <field name="nb_heures"/>
                                    <field name="montant"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Estimations matériaux">
                            <field name="estimation_materiau_ids">
                                <list editable="bottom">
                                    <field name="materiau_id"/>
                                    <field name="quantite_estimee"/>
                                    <field name="unite"/>
                                    <field name="prix_unitaire"/>
                                    <field name="stock_disponible"/>
                                    <field name="quantite_manquante"/>
                                    <field name="montant_estime"/>
                                </list>
                            </field>
                        </page>
                        <page string="Estimations outils">
                            <field name="estimation_outil_ids">
                                <list editable="bottom">
                                    <field name="outil_id"/>
                                    <field name="etat_outil"/>
                                    <field name="date_debut_prevue"/>
                                    <field name="date_fin_prevue"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Attributions outils">
                            <field name="attribution_outil_ids">
                                <list delete="false">
                                    <field name="outil_id"/>
                                    <field name="ouvrier_id"/>
                                    <field name="date_sortie"/>
                                    <field name="date_retour_prevue"/>
                                    <field name="date_retour_reelle"/>
                                    <field name="state"/>
                                    <button name="unlink" type="object" icon="fa-trash-o"
                                            confirm="Êtes-vous sûr de vouloir supprimer cette attribution ?"
                                            class="btn-sm btn-link text-danger"/>
                                </list>
                            </field>
                        </page>
                        <page string="Demandes matériel">
                            <field name="demande_materiel_ids">
                                <list>
                                    <field name="ouvrier_id"/>
                                    <field name="date"/>
                                    <field name="description"/>
                                    <field name="quantite"/>
                                    <field name="urgence"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Rapports journaliers">
                            <field name="rapport_journalier_ids">
                                <list>
                                    <field name="date"/>
                                    <field name="auteur_id"/>
                                    <field name="meteo"/>
                                    <field name="nb_ouvriers"/>
                                </list>
                            </field>
                        </page>
                        <page string="Photos">
                            <field name="photo_ids">
                                <kanban>
                                    <field name="name"/>
                                    <field name="image"/>
                                    <field name="date"/>
                                    <templates>
                                        <t t-name="card">
                                            <img t-att-src="'/web/image/chantier.photo/' + record.id.value + '/image'"
                                                 t-att-alt="record.name.value"
                                                 style="max-height:120px; object-fit:cover; width:100%;"/>
                                            <div class="p-2">
                                                <strong><field name="name"/></strong>
                                                <div><field name="date"/></div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="Plans">
                            <field name="plan_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="version"/>
                                    <field name="date"/>
                                    <field name="auteur_id"/>
                                    <field name="fichier_name"/>
                                </list>
                            </field>
                        </page>
                        <page string="Paiements FSS">
                            <field name="paiement_fss_ids">
                                <list>
                                    <field name="ouvrier_id"/>
                                    <field name="periode"/>
                                    <field name="montant"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List view -->
    <record id="view_chantier_chantier_list" model="ir.ui.view">
        <field name="name">chantier.chantier.list</field>
        <field name="model">chantier.chantier</field>
        <field name="arch" type="xml">
            <list string="Chantiers" decoration-success="state == 'termine'"
                  decoration-danger="state == 'annule'" decoration-info="state == 'en_cours'">
                <field name="ref"/>
                <field name="name"/>
                <field name="client_id"/>
                <field name="chef_chantier_id"/>
                <field name="date_debut"/>
                <field name="date_fin_prevue"/>
                <field name="budget_initial"/>
                <field name="avancement" widget="progressbar"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'termine'"
                       decoration-warning="state == 'en_cours'"
                       decoration-danger="state == 'annule'"/>
            </list>
        </field>
    </record>

    <!-- Kanban view -->
    <record id="view_chantier_chantier_kanban" model="ir.ui.view">
        <field name="name">chantier.chantier.kanban</field>
        <field name="model">chantier.chantier</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_mobile">
                <field name="name"/>
                <field name="client_id"/>
                <field name="chef_chantier_id"/>
                <field name="budget_initial"/>
                <field name="avancement"/>
                <field name="state"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="fw-bold fs-5"><field name="name"/></div>
                        <div class="text-muted"><field name="client_id"/></div>
                        <div>Chef : <field name="chef_chantier_id"/></div>
                        <div>Budget : <field name="budget_initial"/></div>
                        <div class="mt-2">
                            <field name="avancement" widget="progressbar"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_chantier_chantier_search" model="ir.ui.view">
        <field name="name">chantier.chantier.search</field>
        <field name="model">chantier.chantier</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Chantier"/>
                <field name="ref"/>
                <field name="client_id"/>
                <field name="chef_chantier_id"/>
                <filter string="En cours" name="en_cours" domain="[('state', '=', 'en_cours')]"/>
                <filter string="Brouillon" name="brouillon" domain="[('state', '=', 'brouillon')]"/>
                <filter string="Terminé" name="termine" domain="[('state', '=', 'termine')]"/>
                <group name="groupby">
                    <filter string="Chef de chantier" name="group_chef" context="{'group_by': 'chef_chantier_id'}"/>
                    <filter string="Client" name="group_client" context="{'group_by': 'client_id'}"/>
                    <filter string="État" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_chantier_chantier" model="ir.actions.act_window">
        <field name="name">Chantiers</field>
        <field name="res_model">chantier.chantier</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_chantier_chantier_search"/>
        <field name="context">{'search_default_en_cours': 1}</field>
    </record>
</odoo>
