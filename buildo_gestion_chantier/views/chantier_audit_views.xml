<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Journal des actions terrain -->
    <record id="view_chantier_journal_list" model="ir.ui.view">
        <field name="name">chantier.journal.list</field>
        <field name="model">chantier.journal</field>
        <field name="arch" type="xml">
            <list string="Journal d'audit" create="false" edit="false" delete="false"
                  decoration-muted="action == 'connexion'"
                  decoration-danger="action == 'heures_supprimees'"
                  decoration-warning="action == 'heures_modifiees'">
                <field name="date"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="action" widget="badge"
                       decoration-info="action in ('pointage_arrivee', 'pointage_depart')"
                       decoration-success="action in ('heures_encodees', 'heures_soumises', 'outil_rendu')"
                       decoration-warning="action in ('heures_modifiees', 'outil_pris')"
                       decoration-danger="action == 'heures_supprimees'"/>
                <field name="ouvrier_id" optional="hide"/>
                <field name="chantier_id" optional="show"/>
                <field name="record_name" optional="hide"/>
                <field name="description"/>
                <field name="adresse_ip" optional="hide"/>
                <button name="action_ouvrir" type="object" icon="fa-external-link" title="Ouvrir"
                        invisible="not res_model"/>
                <field name="res_model" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_chantier_journal_search" model="ir.ui.view">
        <field name="name">chantier.journal.search</field>
        <field name="model">chantier.journal</field>
        <field name="arch" type="xml">
            <search string="Rechercher dans le journal d'audit">
                <field name="user_id"/>
                <field name="ouvrier_id"/>
                <field name="chantier_id"/>
                <field name="description"/>
                <field name="adresse_ip"/>
                <separator/>
                <filter string="Connexions" name="connexions" domain="[('action', '=', 'connexion')]"/>
                <filter string="Pointages" name="pointages" domain="[('action', 'in', ('pointage_arrivee', 'pointage_depart'))]"/>
                <filter string="Heures" name="heures"
                        domain="[('action', 'in', ('heures_encodees', 'heures_modifiees', 'heures_soumises', 'heures_supprimees'))]"/>
                <filter string="Heures corrigées ou supprimées" name="heures_corrigees"
                        domain="[('action', 'in', ('heures_modifiees', 'heures_supprimees'))]"/>
                <filter string="Demandes" name="demandes" domain="[('action', 'in', ('demande_creee', 'demande_envoyee'))]"/>
                <filter string="Outils" name="outils" domain="[('action', 'in', ('outil_pris', 'outil_rendu'))]"/>
                <filter string="Tâches et photos" name="taches"
                        domain="[('action', 'in', ('tache_etat', 'point_controle', 'photo_ajoutee'))]"/>
                <separator/>
                <filter string="Aujourd'hui" name="aujourd_hui"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')),
                                  ('date', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter string="Cette semaine" name="cette_semaine"
                        domain="[('date', '&gt;=', (context_today() + relativedelta(weekday=0, days=-6)).strftime('%Y-%m-%d')),
                                  ('date', '&lt;=', (context_today() + relativedelta(weekday=6, days=0)).strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter string="Date" name="filtre_date" date="date"/>
                <group name="groupby">
                    <filter string="Fait par" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Action" name="group_action" context="{'group_by': 'action'}"/>
                    <filter string="Chantier" name="group_chantier" context="{'group_by': 'chantier_id'}"/>
                    <filter string="Jour" name="group_jour" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_chantier_journal" model="ir.actions.act_window">
        <field name="name">Journal d'audit</field>
        <field name="res_model">chantier.journal</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_chantier_journal_search"/>
        <field name="context">{'search_default_cette_semaine': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune action enregistrée sur cette période</p>
            <p>Connexions, pointages, heures encodées ou corrigées, demandes, outils sortis et rendus,
               photos et tâches : chaque action terrain est notée ici, sans pouvoir être modifiée ni effacée.</p>
        </field>
    </record>

    <!-- Historique des modifications de champs suivis -->
    <record id="view_chantier_audit_list" model="ir.ui.view">
        <field name="name">mail.tracking.value.audit.list</field>
        <field name="model">mail.tracking.value</field>
        <field name="arch" type="xml">
            <list string="Journal d'audit" default_order="message_date desc" create="false" edit="false" delete="false">
                <field name="message_date"/>
                <field name="message_author_id"/>
                <field name="model_label"/>
                <field name="record_name"/>
                <field name="field_id"/>
                <field name="old_value_display"/>
                <field name="new_value_display"/>
                <field name="res_model" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_chantier_audit_search" model="ir.ui.view">
        <field name="name">mail.tracking.value.audit.search</field>
        <field name="model">mail.tracking.value</field>
        <field name="arch" type="xml">
            <search string="Rechercher dans le journal d'audit">
                <field name="record_name" string="Enregistrement"/>
                <field name="message_author_id"/>
                <field name="field_id"/>
                <separator/>
                <filter string="Chantiers" name="model_chantier" domain="[('res_model', '=', 'chantier.chantier')]"/>
                <filter string="Tâches" name="model_tache" domain="[('res_model', '=', 'chantier.tache')]"/>
                <filter string="Demandes de matériel" name="model_demande" domain="[('res_model', '=', 'chantier.demande.materiel')]"/>
                <filter string="Heures prestées" name="model_heure" domain="[('res_model', '=', 'chantier.heure.prestee')]"/>
                <filter string="Avenants" name="model_avenant" domain="[('res_model', '=', 'chantier.avenant')]"/>
                <filter string="Paiements FSS" name="model_paiement" domain="[('res_model', '=', 'chantier.paiement.fss')]"/>
                <separator/>
                <filter string="Aujourd'hui" name="aujourd_hui"
                        domain="[('message_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')),
                                  ('message_date', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter string="Cette semaine" name="cette_semaine"
                        domain="[('message_date', '&gt;=', (context_today() + relativedelta(weekday=0, days=-6)).strftime('%Y-%m-%d')),
                                  ('message_date', '&lt;=', (context_today() + relativedelta(weekday=6, days=0)).strftime('%Y-%m-%d 23:59:59'))]"/>
                <group name="groupby">
                    <filter string="Type d'enregistrement" name="group_model" context="{'group_by': 'model_label'}"/>
                    <filter string="Modifié par" name="group_author" context="{'group_by': 'message_author_id'}"/>
                    <filter string="Jour" name="group_date" context="{'group_by': 'message_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_chantier_audit" model="ir.actions.act_window">
        <field name="name">Historique des modifications</field>
        <field name="res_model">mail.tracking.value</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_chantier_audit_list"/>
        <field name="domain">[('res_model', 'in', ['chantier.chantier', 'chantier.tache', 'chantier.demande.materiel', 'chantier.heure.prestee', 'chantier.avenant', 'chantier.paiement.fss'])]</field>
        <field name="search_view_id" ref="view_chantier_audit_search"/>
        <field name="context">{'search_default_cette_semaine': 1}</field>
    </record>
</odoo>
