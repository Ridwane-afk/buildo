<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chantier_tache_list" model="ir.ui.view">
        <field name="name">chantier.tache.list</field>
        <field name="model">chantier.tache</field>
        <field name="arch" type="xml">
            <list string="Tâches" editable="bottom" delete="false"
                  decoration-success="state == 'fait'" decoration-danger="state == 'bloque'">
                <field name="sequence" widget="handle"/>
                <field name="chantier_id"/>
                <field name="name"/>
                <field name="responsable_id"/>
                <field name="date_debut"/>
                <field name="date_fin"/>
                <field name="date_fin_reelle"/>
                <field name="avancement" widget="progressbar"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'fait'"
                       decoration-warning="state == 'en_cours'"
                       decoration-danger="state == 'bloque'"/>
                <button name="action_open_form" type="object" icon="fa-external-link"
                        class="btn-sm btn-link" title="Voir le détail"/>
                <button name="unlink" type="object" icon="fa-trash-o"
                        confirm="Êtes-vous sûr de vouloir supprimer cette tâche ?"
                        class="btn-sm btn-link text-danger"/>
            </list>
        </field>
    </record>

    <record id="view_chantier_tache_form" model="ir.ui.view">
        <field name="name">chantier.tache.form</field>
        <field name="model">chantier.tache</field>
        <field name="arch" type="xml">
            <form string="Tâche">
                <header>
                    <button name="action_demarrer" string="Reprendre" type="object"
                            invisible="state == 'en_cours'" class="btn-primary"/>
                    <button name="action_valider" string="Valider" type="object"
                            invisible="state == 'fait'" class="btn-primary"/>
                    <button name="action_bloquer" string="Bloquer" type="object"
                            invisible="state in ('fait', 'bloque')" class="btn-secondary"/>
                    <button name="action_remettre_a_faire" string="Remettre à faire" type="object"
                            invisible="state == 'a_faire'" class="btn-secondary"/>
                    <button name="action_facturer" string="Facturer au client" type="object"
                            invisible="state != 'fait' or (facture_id and facture_state != 'cancel')" class="btn-primary"
                            groups="buildo_gestion_chantier.group_direction"/>
                    <field name="facture_state" invisible="1"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_facture" type="object" class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not facture_id">
                            <field name="facture_id" widget="statinfo" string="Facture"/>
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="chantier_id"/>
                        <field name="responsable_id"/>
                        <field name="date_debut"/>
                        <field name="date_fin"/>
                        <field name="date_fin_reelle"/>
                        <field name="avancement" widget="progressbar" readonly="checklist_ids"/>
                        <div class="text-muted small" colspan="2" invisible="not checklist_ids">
                            Calculé automatiquement à partir des sous-tâches cochées ci-dessous.
                        </div>
                        <field name="currency_id" invisible="1"/>
                        <field name="montant_facturable"/>
                    </group>
                    <div class="alert alert-success d-flex align-items-center mb-3" role="alert"
                         invisible="state == 'fait' or not checklist_ids or avancement != 100">
                        <i class="fa fa-check-circle me-2"/>
                        Toutes les sous-tâches sont cochées. Vous pouvez valider la tâche.
                    </div>
                    <field name="description" placeholder="Description de la tâche..."/>
                    <field name="note" placeholder="Notes..."/>
                    <notebook>
                        <page string="Sous-tâches">
                            <field name="checklist_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="fait"/>
                                    <field name="name"/>
                                    <field name="note"/>
                                    <field name="fait_par_id" readonly="1"/>
                                    <field name="fait_le" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Matériaux nécessaires">
                            <field name="estimation_materiau_ids" context="{'default_chantier_id': chantier_id}">
                                <list editable="bottom" decoration-danger="quantite_manquante &gt; 0">
                                    <field name="materiau_id"/>
                                    <field name="quantite_estimee"/>
                                    <field name="unite"/>
                                    <field name="prix_unitaire"/>
                                    <field name="stock_disponible"/>
                                    <field name="quantite_manquante"/>
                                    <field name="montant_estime"/>
                                </list>
                            </field>
                        </page>
                        <page string="Outils nécessaires">
                            <field name="estimation_outil_ids" context="{'default_chantier_id': chantier_id}">
                                <list editable="bottom">
                                    <field name="outil_id"/>
                                    <field name="etat_outil"/>
                                    <field name="date_debut_prevue"/>
                                    <field name="date_fin_prevue"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Documents">
                            <field name="document_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="fichier" filename="fichier_name"/>
                                    <field name="fichier_name" column_invisible="1"/>
                                    <field name="auteur_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Photos de preuve">
                            <field name="photo_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="auteur_id"/>
                                    <field name="image" widget="image" options="{'size': [64, 64]}"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_chantier_tache_search" model="ir.ui.view">
        <field name="name">chantier.tache.search</field>
        <field name="model">chantier.tache</field>
        <field name="arch" type="xml">
            <search string="Rechercher une tâche">
                <field name="name" string="Tâche"/>
                <field name="chantier_id"/>
                <field name="responsable_id"/>
                <separator/>
                <filter string="En retard" name="en_retard"
                        domain="[('date_fin', '&lt;', context_today().strftime('%Y-%m-%d')), ('state', 'not in', ['fait'])]"/>
                <filter string="À faire" name="a_faire" domain="[('state', '=', 'a_faire')]"/>
                <filter string="En cours" name="en_cours" domain="[('state', '=', 'en_cours')]"/>
                <filter string="Bloqué" name="bloque" domain="[('state', '=', 'bloque')]"/>
                <filter string="Terminé" name="fait" domain="[('state', '=', 'fait')]"/>
                <separator/>
                <filter string="Début cette semaine" name="debut_semaine"
                        domain="[('date_debut', '&gt;=', (context_today() + relativedelta(weekday=0, days=-6)).strftime('%Y-%m-%d')),
                                  ('date_debut', '&lt;=', (context_today() + relativedelta(weekday=6, days=0)).strftime('%Y-%m-%d'))]"/>
                <filter string="Fin cette semaine" name="fin_semaine"
                        domain="[('date_fin', '&gt;=', (context_today() + relativedelta(weekday=0, days=-6)).strftime('%Y-%m-%d')),
                                  ('date_fin', '&lt;=', (context_today() + relativedelta(weekday=6, days=0)).strftime('%Y-%m-%d'))]"/>
                <filter string="Fin ce mois" name="fin_mois"
                        domain="[('date_fin', '&gt;=', context_today().strftime('%Y-%m-01')),
                                  ('date_fin', '&lt;', (context_today() + relativedelta(months=1)).strftime('%Y-%m-01'))]"/>
                <group name="groupby">
                    <filter string="Chantier" name="group_chantier" context="{'group_by': 'chantier_id'}"/>
                    <filter string="Responsable" name="group_responsable" context="{'group_by': 'responsable_id'}"/>
                    <filter string="État" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_chantier_tache" model="ir.actions.act_window">
        <field name="name">Tâches</field>
        <field name="res_model">chantier.tache</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_chantier_tache_search"/>
        <field name="context">{'search_default_group_chantier': 1, 'search_default_group_responsable': 1}</field>
    </record>
</odoo>
