<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chantier_materiau_list" model="ir.ui.view">
        <field name="name">chantier.materiau.list</field>
        <field name="model">chantier.materiau</field>
        <field name="arch" type="xml">
            <list string="Matériaux" decoration-danger="stock_disponible &lt;= seuil_alerte">
                <field name="name"/>
                <field name="ref_interne"/>
                <field name="product_id"/>
                <field name="categorie"/>
                <field name="unite"/>
                <field name="prix_unitaire"/>
                <field name="stock_disponible"/>
                <field name="seuil_alerte"/>
            </list>
        </field>
    </record>

    <record id="view_chantier_materiau_form" model="ir.ui.view">
        <field name="name">chantier.materiau.form</field>
        <field name="model">chantier.materiau</field>
        <field name="arch" type="xml">
            <form string="Matériau">
                <sheet>
                    <group>
                        <group string="Identification">
                            <field name="name"/>
                            <field name="ref_interne"/>
                            <field name="categorie"/>
                            <field name="unite"/>
                            <field name="actif"/>
                        </group>
                        <group string="Stock et prix">
                            <field name="product_id"/>
                            <field name="prix_unitaire"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="stock_disponible"
                                   readonly="product_id != False"/>
                            <field name="seuil_alerte"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_chantier_materiau_search" model="ir.ui.view">
        <field name="name">chantier.materiau.search</field>
        <field name="model">chantier.materiau</field>
        <field name="arch" type="xml">
            <search string="Rechercher un matériau">
                <field name="name" string="Nom"/>
                <field name="ref_interne"/>
                <field name="product_id"/>
                <field name="categorie"/>
                <field name="unite"/>
                <separator/>
                <filter string="Sous le seuil d'alerte" name="sous_seuil" domain="[('en_alerte', '=', True)]"/>
                <filter string="En rupture" name="rupture" domain="[('stock_disponible', '&lt;=', 0)]"/>
                <separator/>
                <filter string="Lié à un produit" name="avec_produit" domain="[('product_id', '!=', False)]"/>
                <filter string="Sans produit lié" name="sans_produit" domain="[('product_id', '=', False)]"/>
                <separator/>
                <filter string="Archivés" name="archives" domain="[('actif', '=', False)]"/>
                <group name="groupby">
                    <filter string="Catégorie" name="group_categorie" context="{'group_by': 'categorie'}"/>
                    <filter string="Unité" name="group_unite" context="{'group_by': 'unite'}"/>
                    <filter string="Produit lié" name="group_produit" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_chantier_materiau" model="ir.actions.act_window">
        <field name="name">Matériaux</field>
        <field name="res_model">chantier.materiau</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('actif', '=', True)]</field>
        <field name="search_view_id" ref="view_chantier_materiau_search"/>
        <field name="context">{'search_default_group_categorie': 1}</field>
    </record>
</odoo>
