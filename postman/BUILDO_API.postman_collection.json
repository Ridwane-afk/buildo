              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Pagination présente', () => pm.expect(body).to.have.keys('total', 'limit', 'offset', 'results'));",
                  "pm.test('Au plus 10 résultats', () => pm.expect(body.results.length).to.be.at.most(10));"
                ],
                "type": "text/javascript",
                "id": "b68523cb-d692-474f-8f65-df4f9e3822b1"
