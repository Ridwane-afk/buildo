              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "const body = pm.response.json();",
                  "pm.test('Explique les transactions', () => pm.expect(body.error).to.include('heure(s) prestée(s)'));",
                  "pm.test('Propose l\\'archivage', () => pm.expect(body.solution).to.include('\"active\": false'));"
