              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Référence générée', () => pm.expect(body.ref).to.not.equal('Nouveau'));",
                  "pm.test('Actif par défaut', () => pm.expect(body.active).to.be.true);",
                  "pm.collectionVariables.set('chantier_id', body.id);"
                ],
                "type": "text/javascript",
                "id": "caec4480-fc67-404c-89b7-66f72299810c"
